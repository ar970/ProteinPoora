# Copy to .env and fill in. Never commit .env — this repository is public.
#
# Razorpay → Dashboard → Account & Settings → API Keys.
# KEY_ID is publishable: the browser needs it to open the checkout modal, and
# /api/create-order hands it over so the key lives in one place only.
# KEY_SECRET signs payment verification. It must never reach the browser, and
# it must never be committed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Only needed for the dormant /api/preorders fallback. Orders go to Supabase
# from the browser today; see docs/ADMIN-SETUP.md.
# DATABASE_URL=
